{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "caveman shrink-hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.caveman/bin/caveman-proxy\" native-hook claude --adapter \"$HOME/.nvm/versions/node/v20.20.2/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
