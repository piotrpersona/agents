{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_PLAN": "Pro",
    "CLAUDE_STATUSLINE_NERDFONT": "1",
    "COLORTERM": "truecolor"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/target/**)",
      "Read(./**/*.lock)"
    ]
  },
  "model": "claude-opus-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codegraph-init-check.sh",
            "timeout": 10,
            "statusMessage": "Checking CodeGraph index..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "timeout": 10
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "theme": "dark"
}
